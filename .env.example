# Live demo services hosted outside Vercel.
#
# The warehouse automation demo runs as a container on AWS (see the
# warehouse-automation-aws directory). Leave this blank until that service is
# deployed — the project page renders a "demo is being prepared" note when it
# is unset, and a "Try the Live Demo" button when it is set.
#
# Must be https. Set it in the Vercel dashboard for Production, Preview and
# Development. NEXT_PUBLIC_ values are inlined at build time, so changing this
# requires a redeploy.
#
# Example: https://warehouse.d7tech.net
NEXT_PUBLIC_WAREHOUSE_DEMO_URL=

# Contact form (already configured in Vercel; listed here for completeness).
RESEND_API_KEY=
